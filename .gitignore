.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# Editor / IDE
# ─────────────────────────────────────────────────────────────
.vscode/
.vs/
carPosTracking.code-workspace

# ─────────────────────────────────────────────────────────────
# Container stacks — local secrets (never commit)
# ─────────────────────────────────────────────────────────────
# Covers Postgres, MQTTBroker and App. Each stack keeps a committed
# .env.example listing every key with the secret values left empty; the real
# .env sits beside it and stays out of git.
Container/**/.env

# ─────────────────────────────────────────────────────────────
# ESP32 firmware (PlatformIO / ESP-IDF)
# ─────────────────────────────────────────────────────────────
# PlatformIO
ESP32/.pio
ESP32/.pioenvs
ESP32/.piolibdeps
ESP32/.clang_complete
ESP32/.gcc-flags.json

# Secrets: the real config holds WiFi credentials and must never be committed.
# The committed template is src/config/Config.example.h (no credentials).
ESP32/src/config/Config.h

# Python tool caches
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────
# API — C# / .NET
# ─────────────────────────────────────────────────────────────
API/
FE/
Container/App/.env.example
Container/App/docker-compose.yml
