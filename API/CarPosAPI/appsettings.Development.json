{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Turned back up from the Warning that appsettings.json sets: on a developer
      // machine the generated SQL is one of the more useful things in the console,
      // and the log is not being shipped anywhere.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AuthCookie": {
    // Development only. The Vite dev server proxies /api over plain HTTP, and a
    // Secure cookie would never be sent back over that, so sign-in would appear
    // to succeed and every following request would come back 401. Production
    // keeps the default (true) — this file is not deployed.
    "SecureCookies": false
  }
}
