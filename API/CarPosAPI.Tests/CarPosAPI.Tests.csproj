    <Authors>Jiri Majer</Authors>
    <Copyright>Copyright (c) 2026 Jiri Majer</Copyright>
    <PackageLicenseExpression>LicenseRef-PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
