{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthCookie": {
    // Development only. The Vite dev server proxies /api over plain HTTP, and a
    // Secure cookie would never be sent back over that, so sign-in would appear
    // to succeed and every following request would come back 401. Production
    // keeps the default (true) — this file is not deployed.
    "SecureCookies": false
  }
}
