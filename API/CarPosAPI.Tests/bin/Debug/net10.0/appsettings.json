{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": {
    "PathBase": "/carPosAPI"
  },
  "ConnectionStrings": {
    "CarPos": ""
  },
  "Mqtt": {
    "BrokerUri": "wss://jimajer.cz:443/mqttBroker",
    "Username": "carpos-api",
    "Password": "",
    "ClientId": "carpos-api",
    "TopicFilter": "devices/+",
    "KeepAliveSeconds": 30,
    "ReconnectMinDelaySeconds": 1,
    "ReconnectMaxDelaySeconds": 60
  },
  "DeviceKeyProtection": {
    "MasterKeyBase64": ""
  },
  "Jwt": {
    "Issuer": "carpos-api",
    "Audience": "carpos-fe",
    "SigningKey": "",
    "LifetimeHours": 8
  },
  "AuthCookie": {
    "SessionCookieName": "carpos_session",
    "CsrfCookieName": "carpos_csrf",
    "CsrfHeaderName": "X-CSRF-Token",
    "SecureCookies": true
  }
}
