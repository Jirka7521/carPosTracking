# Copy this file to .env and set the user names. .env is gitignored.
#
# Passwords are NOT in .env any more: each is a file in ./secrets/ (also
# gitignored), mounted read-only into the broker at /run/secrets/<NAME>, because
# Docker keeps a container's environment in plain text in its config on the host.
#   mkdir -p secrets && chmod 700 secrets
#   (write secrets/ADMIN_PASSWORD, DEVICE_PASSWORD, DASHBOARD_PASSWORD and
#    HEALTHCHECK_PASSWORD with an editor, one line each)
#   chmod 600 secrets/*
# Compose refuses to start until all four files exist. (The entrypoint still
# accepts *_PASSWORD environment variables when no file is mounted - for a plain
# `docker run` - but this compose file passes none.)
#
# Every account here is mandatory: the broker refuses to boot if any user or
# password is empty. Anonymous connections are rejected outright, so a client
# without credentials in this file cannot reach the broker at all.
#
# The usernames are also hard-coded in mosquitto/acl - if you change a *_USER
# here you must change the matching `user <name>` line in the ACL, or that
# account keeps its login but loses every permission.

# Host port for plain MQTT (LAN clients / ESP32). The WebSocket listener is not
# published; it is only reachable through nginx.
MQTT_PORT=1883
# Host port for nginx, bound to 127.0.0.1. Only used when cloudflared runs on the
# host instead of as a container on the MQTTpublic network.
NGINX_PORT=8083

# admin: full read/write on every topic, plus $SYS. For manual debugging.
ADMIN_USER=admin
# Password: secrets/ADMIN_PASSWORD (one line, no quotes)

# GNSS01: the tracker. Publishes devices/GNSS01 and its /status; reads its
# /config, /schedule and /ack. Must equal kMqttUsername in the firmware's Config.h.
DEVICE_USER=GNSS01
# Password: secrets/DEVICE_PASSWORD (one line, no quotes)

# dashboard: the API. Reads devices/#; writes devices/+/ack, /config, /schedule
# and /cmd. Must equal MQTT_USERNAME in the API's .env - the ACL names it literally.
DASHBOARD_USER=dashboard
# Password: secrets/DASHBOARD_PASSWORD (one line, no quotes)

# healthcheck: the container's liveness probe. Scoped to healthcheck/probe only,
# so these credentials grant no access to device data. Internal listener only.
HEALTHCHECK_USER=healthcheck
# Password: secrets/HEALTHCHECK_PASSWORD (one line, no quotes)

# Whether the dashboard account may also log in over the public WebSocket
# listener (9001). admin and healthcheck never can. Leave true while the API's
# MQTT_BROKER_URI is still ws://mqtt.local:9001; set false once it is
# mqtt://mqtt.local:1883 (the internal listener). Optional - defaults to true.
DASHBOARD_ON_WEBSOCKETS=true
