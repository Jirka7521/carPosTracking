# Copy this file to .env in the same directory and fill in real values.
# .env is git-ignored — never commit it.
#
# Every variable below is mandatory: docker-compose.yml declares them with
# ${VAR:?message}, so `docker compose up` aborts with a clear error rather than
# starting a container that would fail (or, worse, half-work) at runtime.

# --- Database -----------------------------------------------------------
# Must match the values the Postgres stack was initialised with
# (Container/Postgres/.env). The API connects as the BE role, which has DML
# rights only — migrations are applied separately as admin.
POSTGRES_DB=carpos
BE_USER=carpos_be
BE_PASSWORD=

# --- MQTT ---------------------------------------------------------------
# The API subscribes to devices/+ as this account. The URI must use a
# TLS-secured scheme (wss:// or mqtts://); the API validates that at start-up
# and refuses to run otherwise.
MQTT_BROKER_URI=wss://jimajer.cz:443/mqttBroker
MQTT_USERNAME=carpos-api
MQTT_PASSWORD=

# --- Secrets ------------------------------------------------------------
# Base64 of exactly 32 random bytes. This key encrypts every device's RSA
# private key at rest; losing it makes all stored positions undecryptable for
# future devices, and leaking it undoes the end-to-end encryption entirely.
#   openssl rand -base64 32
DEVICE_KEY_MASTER_KEY=

# At least 32 bytes. Signs the session JWTs — anyone holding this can mint a
# token for any account, so treat it exactly like a password database.
# Rotating it invalidates every active session, which is the intended effect.
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Frontend -----------------------------------------------------------
# Google Maps JavaScript API key. It is served to the browser and cannot be
# kept secret — restrict it by HTTP referrer in the Google Cloud console so a
# copied key is useless from any other origin.
CARPOS_GOOGLE_MAPS_API_KEY=

# Host port the dashboard is published on, bound to loopback only. The
# Cloudflare tunnel (or whatever terminates TLS) points at this.
FE_PORT=8080

# --- Published path prefixes --------------------------------------------
# Both are OPTIONAL — the compose file already defaults them to the values
# below, so leaving them out changes nothing. They exist because the Cloudflare
# tunnel publishes each service under a path and forwards that path verbatim:
# the dashboard at https://jimajer.cz/carPosFE and the API at
# https://jimajer.cz/carPosAPI. nginx and the API strip their own prefix when a
# request carries it, so the un-prefixed URLs (the loopback ports, the
# healthchecks, the in-network /api proxy) keep working exactly as before —
# both spellings are live at the same time.
#
# Change these only if the tunnel's routes are renamed. Set either to an empty
# value to serve that side at the root only.
FE_BASE_PATH=/carPosFE
API_PATH_BASE=/carPosAPI
