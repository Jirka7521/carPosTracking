# Copy this file to .env and adjust the values. .env is gitignored.

# The database to create on first init.
POSTGRES_DB=carpos
# Host port mapped to the container's 5432. Change if 5432 is already in use.
POSTGRES_PORT=5432

# admin: the superuser / owner. Bootstrapped by the image on first init.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# dashboard: read-only (SELECT) login, created by initdb/02-create-users.sh.
DASHBOARD_USER=dashboard
DASHBOARD_PASSWORD=change_me_to_a_strong_password
