# Copy this file to .env and adjust the values. .env is gitignored.
#
# Passwords are files in ./secrets/ (gitignored), not values here:
#   mkdir -p secrets && chmod 700 secrets
#   (write secrets/ADMIN_PASSWORD and secrets/BE_PASSWORD, one line each)
#   chmod 644 secrets/*      # the image reads them as the postgres user

# The database to create on first init.
POSTGRES_DB=carpos
# Host port mapped to the container's 5432. Change if 5432 is already in use.
POSTGRES_PORT=5432

# admin: the superuser / owner. Bootstrapped by the image on first init.
ADMIN_USER=admin
# Password: secrets/ADMIN_PASSWORD (one line, no quotes)

# BE: read/write (SELECT/INSERT/UPDATE/DELETE, no DDL) login for the backend,
# created by initdb/02-create-users.sh.
BE_USER=BE
# Password: secrets/BE_PASSWORD - the same value the App bundle's
# secrets/ConnectionStrings__CarPos carries.
