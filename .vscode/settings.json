{
    // Pin the solution for the C# extension. Without it, this multi-root
    // workspace has no .sln at its root and the extension can fail to associate
    // Program.cs with CarPosAPI.csproj — it then compiles the file on its own as
    // a .NET 10 "file-based app", and every project namespace and NuGet
    // reference reports as missing (CS0246 / CS0234 on the using directives).
    "dotnet.defaultSolution": "API/CarPos.sln",
    // The publisher (Ctrl+Shift+M) writes Application/, which holds a COPY of the
    // API and FE sources — including CarPos.sln and both csproj files. Left visible
    // to the tooling, the C# extension loads that second copy as another project:
    // duplicate Go-to-Definition results, needless CPU, and — the reason these
    // excludes exist — a language-server handle on Application\api-src that made a
    // re-run of the publisher fail with "being used by another process".
    //
    // Application/ is a build artifact (git-ignored, regenerated on every publish),
    // so hiding it here costs nothing; the script prints its absolute path when it
    // finishes, and Windows Explorer still shows it for copying to the Pi.
    "files.exclude": {
        "**/Application": true
    },
    "search.exclude": {
        "**/Application": true
    },
    "files.watcherExclude": {
        "**/Application/**": true
    },
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}