# Reference only. The real Application/.env is generated by
# scripts/Publish-Deployment.ps1 (Ctrl+Shift+M) — you do not fill this in by
# hand. It lists every key the bundle's docker-compose.yml expects, so you can
# see at a glance what the wizard collects.
#
# Every variable is mandatory: docker-compose.yml declares them with
# ${VAR:?message}, so `docker compose up` aborts with a clear error rather than
# starting a container that would fail (or half-work) at runtime.
#
# Four of them the wizard DERIVES rather than asks for — FE_BIND_ADDR,
# BE_BIND_ADDR, BE_URL and FE_URL. They are written to .env because compose reads
# them, but each is computed from a host name and a port, so change the name, not
# the derived value.

# --- Database -----------------------------------------------------------
# Must match the values the Postgres stack was initialised with
# (Container/Postgres/.env). The API connects as the BE role, which has DML
# rights only — migrations are applied separately as admin.
POSTGRES_DB=carpos
BE_USER=carpos_be
BE_PASSWORD=

# --- MQTT ---------------------------------------------------------------
# "mqtt.local" is the alias the broker stack gives its Mosquitto service and 9001
# is its WebSocket listener, so this reaches the broker over the shared Docker
# network — nothing goes out to Cloudflare and back. Plaintext ws:// is accepted
# precisely because the hop never leaves the host; payloads are end-to-end
# encrypted by the firmware anyway. Allowed schemes: ws, wss, mqtt, mqtts.
#
# CAVEAT: this same value is written into device firmware as kMqttBrokerUri, and
# port 9001 is NOT published to the host — so a device cannot reach this address.
# Replace that line by hand in any generated provisioning snippet.
MQTT_BROKER_URI=ws://mqtt.local:9001/

# The API subscribes to devices/+ as this account. It must exist in the broker's
# ACL (Container/MQTTBroker/mosquitto/acl) with read on devices/# — "dashboard"
# already does; "carpos-api" does not exist unless you add it.
MQTT_USERNAME=dashboard
MQTT_PASSWORD=

# --- Secrets ------------------------------------------------------------
# Base64 of exactly 32 random bytes. This key encrypts every device's RSA
# private key at rest; losing it makes all stored positions undecryptable for
# future devices, and leaking it undoes the end-to-end encryption entirely.
# The wizard's [G]enerate option produces a valid value.
DEVICE_KEY_MASTER_KEY=

# At least 32 bytes. Signs the session JWTs — anyone holding this can mint a
# token for any account, so treat it exactly like a password database.
# Rotating it invalidates every active session, which is the intended effect.
JWT_SIGNING_KEY=

# --- Frontend -----------------------------------------------------------
# Google Maps JavaScript API key. It is served to the browser and cannot be
# kept secret — restrict it by HTTP referrer in the Google Cloud console so a
# copied key is useless from any other origin.
CARPOS_GOOGLE_MAPS_API_KEY=

# --- Host names ---------------------------------------------------------
# The LAN names your DHCP/DNS server serves for the two containers. These are the
# values to edit; everything else in this section is derived from them.
#
# Each name is ALSO registered as a Docker network alias on MQTTpublic, so it
# resolves twice over and correctly both times: from the LAN it points at the
# host and hits the published port below; from inside a container Docker's own
# DNS answers first and points straight at the container. That is what lets the
# frontend's nginx, the API healthcheck and a browser all use one address —
# without the alias, a container resolving the LAN name would have to hairpin
# back through the host, which is what once left the API stuck "unhealthy".
#
# Use "localhost" for either to keep that half off the LAN entirely, reachable
# only through whatever terminates TLS in front of it.
FE_HOST=carposfe.local
BE_HOST=carposbe.local

# DERIVED from the names above: the wizard resolves each name through DNS and
# writes the answer here, because Docker's published-port syntax is
# <hostIP>:<hostPort>:<containerPort> and parses the host side as an IP literal —
# a hostname there is rejected.
#
# These must match the ipv4_address each container is PINNED to in
# docker-compose.yml (.5 api, .6 fe). MQTTpublic is a macvlan network, so the
# container owns that LAN address outright; the wizard warns when DNS and the pin
# disagree. Edit the name above and keep the DNS record and the pin in step —
# nothing else on the LAN, the Pi included, may hold these addresses.
FE_BIND_ADDR=192.168.124.6
BE_BIND_ADDR=192.168.124.5

# Host ports the two containers are published on, on their own interfaces above.
#
# Keep these equal to the container ports (fe 80, api 8080). Then a name means
# the same thing from the LAN and from inside Docker; diverge and the alias needs
# the container port while a browser needs this one.
FE_PORT=80
BE_PORT=8080

# Whether the session cookie carries the Secure flag. Must be false if the
# dashboard is served over plain http:// (any non-loopback FE_BIND_ADDR) — a
# browser silently drops a Secure cookie there, so login succeeds and every
# following request 401s. true whenever a TLS terminator sits in front.
AUTH_SECURE_COOKIES=false

# --- URLs (derived) -----------------------------------------------------
# BE_URL is BE_HOST plus the API's CONTAINER port, 8080 — the port the alias
# reaches, which is not necessarily BE_PORT. Two consumers: the frontend's nginx
# proxies /api/ here, and the API's own healthcheck probes it, so the check
# exercises the same route the frontend uses.
#
# No trailing slash and no path: with one, nginx would strip the /api/ prefix and
# every backend route would 404. The entrypoint removes a stray slash anyway.
BE_URL=http://carposbe.local:8080

# The dashboard's public, browser-facing address, derived from FE_HOST/FE_PORT
# (https when AUTH_SECURE_COOKIES is true, since that implies a TLS terminator).
# Not used by the containers — it is what the publisher prints and what the
# README points at.
FE_URL=http://carposfe.local
