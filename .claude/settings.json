{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:main *)",
      "Bash(git push * +main)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * --force-with-lease=*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * HEAD:main)",
      "PowerShell(git push * HEAD:main *)",
      "PowerShell(git push * +main)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * --force-with-lease)",
      "PowerShell(git push * --force-with-lease *)",
      "PowerShell(git push * --force-with-lease=*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push -f *)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)"
    ]
  }
}
